# ===== Production Environment Variables =====
# À utiliser pour le déploiement sur GitHub Pages + Vercel

# Frontend
VITE_API_URL=https://victory-tracker-api.vercel.app
VITE_GITHUB_CLIENT_ID=your_production_github_client_id

# Backend (Vercel env vars)
