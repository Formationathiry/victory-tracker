{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/neon-auth.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/neon-auth.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/neon-auth.js"
    }
  ]
}
